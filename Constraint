//// composite primary key
create table dna.ddl (
ride_id int,
rider_id int,
passenger_id int,
drop_location varchar (100),
Pickup_location varchar (100),
amount decimal(5,2),
primary key (ride_id, rider_id)
);

//// primay and unique key
create table dna.cons (
Emp_id int primary key,
name varchar (100),
mail_id varchar(100) unique
);
