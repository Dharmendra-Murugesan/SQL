select * from dna.custome_transaction;
select count(*) from dna.custome_transaction;
select count(*) from dna.custome_transaction where status = 'Failed';
select count(*) from dna.custome_transaction where product_name = 'Mobile' and price > 3000;
select count(*) from dna.custome_transaction where product_name = 'TV' or status = 'Failed';
select count(*) from dna.custome_transaction where Status in ('Ordered','Failed');
select count(*) from dna.custome_transaction where Status not in ('Pending');
select sum(price) from dna.custome_Transaction;
select sum(price) from dna.custome_Transaction where status = 'Ordered';
select sum(price) as Total_Amount from dna.custome_Transaction where status = 'Ordered';
select min(price) as Minimum_Amount from dna.custome_Transaction;
select max(price) as Maximum_Amount from dna.custome_Transaction;
select Avg(price) as Average_Amount from dna.custome_Transaction;
select product_name, sum(price) as Total_Amount from dna.custome_Transaction group by product_name;
select product_name, 
sum(price) as Total_Amount 
from dna.custome_Transaction 
group by product_name
having sum(price) > 4000;
