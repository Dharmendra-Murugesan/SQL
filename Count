use dna;
create table dna.empdb (
emp_id int primary key,
name varchar (100) not null,
place varchar (100)
);
drop table if exists dna.ride;
create table dna.ride(
ride_id int not null,
pickup_point varchar (100) not null,
drop_pont varchar (100) not null,
price decimal(5,2) check (price > 0),
emp_id int,
foreign key (emp_id) REFERENCEs dna.empdb(emp_id)
);
